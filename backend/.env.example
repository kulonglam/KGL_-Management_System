PORT=5000
MONGODB_URI=mongodb://localhost:27017/karibu_groceries
JWT_SECRET=replace_with_secure_secret
NODE_ENV=development

# Comma-separated CORS allow-list
ALLOWED_ORIGINS=http://localhost:5173

# Request/body + rate limit controls
REQUEST_BODY_LIMIT=2mb
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
WRITE_RATE_LIMIT_MAX=120

# Optional metrics access token (send via X-Metrics-Token header)
METRICS_TOKEN=

# Server runtime timeouts
SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_HEADERS_TIMEOUT_MS=35000
SERVER_SHUTDOWN_TIMEOUT_MS=10000

# Stock lock controls
STOCK_LOCK_TTL_MS=5000
STOCK_LOCK_WAIT_TIMEOUT_MS=10000
STOCK_LOCK_RETRY_MS=120
