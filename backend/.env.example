PORT=5000
MONGODB_URI=mongodb://localhost:27017/karibu_groceries
# Password for accounts created by npm run seed. Blank uses Karibu@2026!.
SEED_DEFAULT_PASSWORD=
JWT_SECRET=replace_with_secure_random_64+_char_secret
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Optional outbound messaging
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Background jobs. Schedules persist last-run times in MongoDB, so restarts and
# extra instances do not re-run a job. Weekly slots use UTC (day 0 = Sunday).
OVERDUE_SCAN_INTERVAL_MS=900000
RETENTION_JOB_UTC_DAY=0
RETENTION_JOB_UTC_HOUR=0
WEEKLY_REPORT_UTC_DAY=1
WEEKLY_REPORT_UTC_HOUR=4
JOB_SCHEDULER_TICK_MS=60000
JOB_SCHEDULER_DISABLED=false
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=2000

# Optional Redis job backend (BullMQ). When unset, jobs run in-process.
REDIS_URL=

# Optional OIDC SSO (issuer, client id/secret and redirect URI are required together).
# The callback sets the refresh cookie and redirects to OIDC_FRONTEND_REDIRECT?sso=success.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/api/v1/auth/oidc/callback
OIDC_FRONTEND_REDIRECT=http://localhost:5173/
OIDC_PROVIDER_NAME=SSO
OIDC_SCOPES=openid profile email
# Claim names and mapping, e.g. OIDC_ROLE_MAP=kgl-directors:director,kgl-managers:manager
OIDC_ROLE_CLAIM=role
OIDC_ROLE_MAP=
OIDC_BRANCH_CLAIM=branch
OIDC_DEFAULT_ROLE=sales_agent
OIDC_DEFAULT_BRANCH=Maganjo
# Create users on first SSO login; set false to require pre-linked accounts.
OIDC_JIT_PROVISIONING=true
# Link an existing local account by verified email on first SSO login.
OIDC_LINK_BY_EMAIL=false
# Overwrite role/branch from IdP claims on every SSO login.
OIDC_SYNC_ROLE=false

# Outbound webhooks. Private/loopback targets are refused in production unless allowed.
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_ALLOW_PRIVATE_TARGETS=
WEBHOOK_REQUIRE_HTTPS=
JWT_ALLOWED_ALGS=HS256

# Business day boundaries ("today", overdue, cash-up default date). Timestamps are stored in UTC.
BUSINESS_TIMEZONE=Africa/Kampala

# AES-256-GCM key for national IDs at rest: 32 bytes as 64 hex chars or base64.
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# After setting it on an existing database run: npm run encrypt-nin
NIN_ENCRYPTION_KEY=
NODE_ENV=development
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=karibu-groceries-api

# Comma-separated CORS allow-list
ALLOWED_ORIGINS=http://localhost:5173

# Auth hardening
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCK_WINDOW_MS=900000
# Spent refresh cookies are rejected immediately and revoke the session.
# The browser holds one refresh lock across tabs, so a second tab sends the replacement cookie.
# How long a stock bucket lock is held. The holder renews it until the write finishes.
STOCK_LOCK_TTL_MS=8000

# API docs exposure
ENABLE_SWAGGER=true
SWAGGER_USERNAME=docsadmin
SWAGGER_PASSWORD=replace_with_secure_docs_password

# Request/body + rate limit controls
REQUEST_BODY_LIMIT=2mb
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
WRITE_RATE_LIMIT_MAX=120

# Server runtime timeouts
SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_HEADERS_TIMEOUT_MS=35000
SERVER_SHUTDOWN_TIMEOUT_MS=10000
